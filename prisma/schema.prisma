generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sites         Site[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Site {
  id          String      @id @default(cuid())
  userId      String
  domain      String
  name        String
  industry    String?
  keywords    String      @default("[]") // JSON array
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentRuns   AgentRun[]
  citations   Citation[]
  contents    Content[]
  siteIssues  SiteIssue[]
  metrics     SiteMetric[]

  @@unique([userId, domain])
}

model AgentRun {
  id         String   @id @default(cuid())
  siteId     String
  agentName  String   // geo-scout | content-architect | site-doctor | ...
  status     String   @default("pending") // pending | running | completed | failed
  startedAt  DateTime?
  completedAt DateTime?
  result     String?  // JSON summary
  error      String?
  createdAt  DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Citation {
  id          String   @id @default(cuid())
  siteId      String
  llm         String   // chatgpt | perplexity | gemini | claude | copilot
  query       String
  cited       Boolean  @default(false)
  sentiment   String?  // positive | neutral | negative
  excerpt     String?  // snippet from LLM response mentioning brand
  position    Int?     // mention position in response
  checkedAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Content {
  id          String   @id @default(cuid())
  siteId      String
  title       String
  slug        String
  body        String   // full markdown content
  wordCount   Int      @default(0)
  status      String   @default("draft") // draft | review | published
  targetKeyword String?
  seoScore    Int?
  geoScore    Int?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SiteIssue {
  id          String   @id @default(cuid())
  siteId      String
  type        String   // broken-link | missing-meta | slow-page | schema-missing | ...
  severity    String   // critical | warning | info
  url         String
  description String
  autoFixed   Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SiteMetric {
  id              String   @id @default(cuid())
  siteId          String
  date            DateTime @default(now())
  citationShare   Float    @default(0)
  organicTraffic  Int      @default(0)
  geoScore        Int      @default(0)
  domainRating    Int      @default(0)
  techScore       Int      @default(0)
  monthlyLeads    Int      @default(0)
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}
