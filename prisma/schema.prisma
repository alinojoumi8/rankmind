generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  name                     String?
  passwordHash             String?
  // Billing
  plan                     String    @default("free")   // free | growth | agency
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String?                      // active | canceled | past_due | trialing
  planCurrentPeriodEnd     DateTime?
  // Google Search Console OAuth
  googleAccessToken        String?
  googleRefreshToken       String?
  // Preferences
  weeklyEmailEnabled       Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  sites                    Site[]
  sessions                 Session[]
  teamMemberships          TeamMember[] @relation("TeamMemberUser")
  teamInvitesSent          TeamMember[] @relation("TeamMemberInviter")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Site {
  id                  String    @id @default(cuid())
  userId              String
  domain              String
  name                String
  industry            String?
  keywords            String    @default("[]") // JSON array
  // Scheduled runs
  scheduleEnabled     Boolean   @default(false)
  scheduleFrequency   String    @default("weekly") // weekly | daily
  lastScheduledRunAt  DateTime?
  // Integrations
  slackWebhookUrl          String?
  googleSearchConsoleSite  String?   // e.g. "sc-domain:example.com" or "https://example.com/"
  createdAt                DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentRuns   AgentRun[]
  citations   Citation[]
  contents    Content[]
  siteIssues  SiteIssue[]
  metrics     SiteMetric[]
  competitors Competitor[]
  reports     Report[]
  teamMembers TeamMember[]

  @@unique([userId, domain])
}

model AgentRun {
  id         String   @id @default(cuid())
  siteId     String
  agentName  String   // geo-scout | content-architect | site-doctor | ...
  status     String   @default("pending") // pending | running | completed | failed
  startedAt  DateTime?
  completedAt DateTime?
  result     String?  // JSON summary
  error      String?
  createdAt  DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Citation {
  id          String   @id @default(cuid())
  siteId      String
  llm         String   // chatgpt | perplexity | gemini | claude | copilot
  query       String
  cited       Boolean  @default(false)
  sentiment   String?  // positive | neutral | negative
  excerpt     String?  // snippet from LLM response mentioning brand
  position    Int?     // mention position in response
  checkedAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Content {
  id          String   @id @default(cuid())
  siteId      String
  title       String
  slug        String
  body        String   // full markdown content
  wordCount   Int      @default(0)
  status      String   @default("draft") // draft | review | published
  targetKeyword String?
  seoScore    Int?
  geoScore    Int?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
}

model SiteIssue {
  id          String   @id @default(cuid())
  siteId      String
  type        String   // broken-link | missing-meta | slow-page | schema-missing | ...
  severity    String   // critical | warning | info
  url         String
  description String
  autoFixed   Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model SiteMetric {
  id              String   @id @default(cuid())
  siteId          String
  date            DateTime @default(now())
  citationShare   Float    @default(0)
  organicTraffic  Int      @default(0)
  geoScore        Int      @default(0)
  domainRating    Int      @default(0)
  techScore       Int      @default(0)
  monthlyLeads    Int      @default(0)
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Competitor {
  id        String   @id @default(cuid())
  siteId    String
  domain    String
  name      String
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  mentions  CompetitorMention[]

  @@unique([siteId, domain])
}

model CompetitorMention {
  id           String   @id @default(cuid())
  competitorId String
  siteId       String
  query        String
  mentioned    Boolean  @default(false)
  checkedAt    DateTime @default(now())
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

model Report {
  id           String   @id @default(cuid())
  siteId       String
  token        String   @unique
  title        String
  snapshotData String   // JSON blob of dashboard snapshot
  viewCount    Int      @default(0)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id              String    @id @default(cuid())
  siteId          String
  invitedByUserId String
  userId          String?   // null until invite accepted
  role            String    @default("editor") // owner | editor | viewer
  inviteEmail     String
  inviteToken     String    @unique
  invitedAt       DateTime  @default(now())
  acceptedAt      DateTime?
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  invitedBy       User      @relation("TeamMemberInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  user            User?     @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: SetNull)
}
